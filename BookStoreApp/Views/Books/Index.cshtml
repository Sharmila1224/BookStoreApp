@model IEnumerable<BookStoreApp.Models.Book>

@{
    ViewData["Title"] = "Book";
}

<div class="container mt-4">
    <h2 class="mb-4 fw-bold">Book List</h2>

    <a asp-action="Create" class="btn btn-success mb-3 px-4">+ Add Book</a>

    <div class="table-responsive shadow rounded">
        <table class="table table-hover align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Title</th>
                    <th>ISBN</th>
                    <th>Date</th>
                    <th>Price</th>
                    <th>Author</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-semibold">@item.Title</td>
                        <td>@item.ISBN</td>
                        <td>@item.PublishedDate.ToShortDateString()</td>
                        <td>₹ @item.Price</td>
                        <td>@item.Author.Name</td>
                        <td class="text-center">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-primary me-1">Edit</a>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info text-white me-1">View</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>